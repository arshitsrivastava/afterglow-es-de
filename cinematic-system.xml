<!-- Cinematic look: home screen -->
<theme>
    <view name="system">
        <gameselector name="bgGame">
            <selection>random</selection>
        </gameselector>
        <gameselector name="lastGame">
            <selection>lastplayed</selection>
        </gameselector>
        <gameselector name="topGame">
            <selection>mostplayed</selection>
        </gameselector>

        <!-- Background: random game fan art from this system -->
        <image name="bgArt">
            <pos>0 0</pos>
            <cropSize>1 1</cropSize>
            <imageType>fanart, screenshot</imageType>
            <gameselector>bgGame</gameselector>
            <interpolation>linear</interpolation>
            <opacity>0.9</opacity>
            <zIndex>2</zIndex>
        </image>
        <image name="shadeLeft">
            <pos>0 0</pos>
            <size>1 1</size>
            <path>${gradLeft}</path>
            <color>${bgColor}</color>
            <zIndex>3</zIndex>
        </image>
        <image name="shadeBottom">
            <pos>0 0</pos>
            <size>1 1</size>
            <path>${gradBottom}</path>
            <color>${bgColor}</color>
            <zIndex>3</zIndex>
        </image>
        <image name="glow">
            <pos>0 0</pos>
            <size>1 1</size>
            <path>./assets/images/ambient.svg</path>
            <color>${accent}</color>
            <opacity>0.56</opacity>
            <zIndex>4</zIndex>
        </image>

        <!-- Title block -->
        <text name="maker">
            <pos>0.056 0.165</pos>
            <size>0.5 0.024</size>
            <text>${systemManufacturer}</text>
            <fontPath>${fontSemi}</fontPath>
            <fontSize>0.024</fontSize>
            <letterCase>uppercase</letterCase>
            <color>${accent}</color>
            <zIndex>40</zIndex>
        </text>
        <text name="sysName">
            <pos>0.053 0.195</pos>
            <size>0.6 0.13</size>
            <text>${systemName}</text>
            <fontPath>${fontDisplay}</fontPath>
            <fontSize>0.13</fontSize>
            <color>${textColor}</color>
            <zIndex>40</zIndex>
        </text>

        <!-- Stats -->
        <text name="statValue1, statValue2, statValue3, statValue4">
            <size>0.1 0.07</size>
            <fontPath>${fontDisplay}</fontPath>
            <fontSize>0.07</fontSize>
            <color>${textColor}</color>
            <zIndex>40</zIndex>
        </text>
        <text name="statLabel1, statLabel2, statLabel3, statLabel4">
            <size>0.1 0.016</size>
            <fontPath>${fontSemi}</fontPath>
            <fontSize>0.016</fontSize>
            <letterCase>uppercase</letterCase>
            <color>${textMute}</color>
            <zIndex>40</zIndex>
        </text>
        <text name="statValue1">
            <pos>0.056 0.355</pos>
            <systemdata>gamecountGamesNoText</systemdata>
        </text>
        <text name="statLabel1">
            <pos>0.056 0.43</pos>
            <text>Games</text>
        </text>
        <text name="statValue2">
            <pos>0.16 0.355</pos>
            <systemdata>gamecountFavoritesNoText</systemdata>
        </text>
        <text name="statLabel2">
            <pos>0.16 0.43</pos>
            <text>Favourites</text>
        </text>
        <text name="statValue3">
            <pos>0.264 0.355</pos>
            <text>${systemReleaseYear}</text>
        </text>
        <text name="statLabel3">
            <pos>0.264 0.43</pos>
            <text>Released</text>
        </text>
        <text name="statValue4">
            <pos>0.368 0.355</pos>
            <size>0.2 0.07</size>
            <text>${systemHardwareType}</text>
        </text>
        <text name="statLabel4">
            <pos>0.368 0.43</pos>
            <text>Type</text>
        </text>
        <image name="accentLine">
            <pos>0.056 0.475</pos>
            <size>0.045 0.004</size>
            <path>${pixel}</path>
            <color>${accent}</color>
            <zIndex>40</zIndex>
        </image>
        <text name="sysDescription">
            <pos>0.056 0.5</pos>
            <size>0.43 0.135</size>
            <text>${systemDescription}</text>
            <container>true</container>
            <fontPath>${fontLight}</fontPath>
            <fontSize>${fsBody}</fontSize>
            <lineSpacing>1.45</lineSpacing>
            <color>${textDim}</color>
            <zIndex>40</zIndex>
        </text>

        <!-- Continue playing / Most played cards -->
        <image name="cardBg1, cardBg2">
            <size>0.285 0.2</size>
            <path>${pixel}</path>
            <color>${panelColor}c8</color>
            <cornerRadius>0.008</cornerRadius>
            <zIndex>5</zIndex>
        </image>
        <image name="cardBg1">
            <pos>0.665 0.165</pos>
        </image>
        <image name="cardBg2">
            <pos>0.665 0.39</pos>
        </image>
        <text name="cardLabel1, cardLabel2">
            <size>0.26 0.016</size>
            <fontPath>${fontSemi}</fontPath>
            <fontSize>0.016</fontSize>
            <letterCase>uppercase</letterCase>
            <color>${accent}</color>
            <zIndex>40</zIndex>
        </text>
        <text name="cardLabel1">
            <pos>0.68 0.183</pos>
            <text>Continue playing</text>
        </text>
        <text name="cardLabel2">
            <pos>0.68 0.408</pos>
            <text>Most played</text>
        </text>
        <image name="cardCover1, cardCover2">
            <maxSize>0.055 0.13</maxSize>
            <imageType>cover, miximage</imageType>
            <cornerRadius>0.003</cornerRadius>
            <interpolation>linear</interpolation>
            <zIndex>30</zIndex>
        </image>
        <image name="cardCover1">
            <pos>0.68 0.215</pos>
            <gameselector>lastGame</gameselector>
        </image>
        <image name="cardCover2">
            <pos>0.68 0.44</pos>
            <gameselector>topGame</gameselector>
        </image>
        <text name="cardName1, cardName2">
            <size>0.19 0.026</size>
            <metadata>name</metadata>
            <fontPath>${fontSemi}</fontPath>
            <fontSize>0.026</fontSize>
            <color>${textColor}</color>
            <zIndex>40</zIndex>
        </text>
        <text name="cardName1">
            <pos>0.745 0.22</pos>
            <gameselector>lastGame</gameselector>
        </text>
        <text name="cardName2">
            <pos>0.745 0.445</pos>
            <gameselector>topGame</gameselector>
        </text>
        <text name="cardTime1, cardTime2">
            <size>0.19 0.021</size>
            <metadata>playtime</metadata>
            <fontPath>${fontRegular}</fontPath>
            <fontSize>0.021</fontSize>
            <color>${accent}</color>
            <zIndex>40</zIndex>
        </text>
        <text name="cardTime1">
            <pos>0.745 0.265</pos>
            <gameselector>lastGame</gameselector>
        </text>
        <text name="cardTime2">
            <pos>0.745 0.49</pos>
            <gameselector>topGame</gameselector>
        </text>
        <datetime name="cardWhen1">
            <pos>0.745 0.297</pos>
            <size>0.19 0.019</size>
            <metadata>lastplayed</metadata>
            <gameselector>lastGame</gameselector>
            <fontPath>${fontRegular}</fontPath>
            <fontSize>0.019</fontSize>
            <color>${textDim}</color>
            <zIndex>40</zIndex>
        </datetime>
        <text name="cardPlays2">
            <pos>0.8 0.522</pos>
            <size>0.1 0.019</size>
            <metadata>playcount</metadata>
            <gameselector>topGame</gameselector>
            <fontPath>${fontRegular}</fontPath>
            <fontSize>0.019</fontSize>
            <color>${textDim}</color>
            <zIndex>40</zIndex>
        </text>
        <text name="cardPlaysLabel2">
            <pos>0.745 0.522</pos>
            <size>0.055 0.019</size>
            <text>Launches</text>
            <fontPath>${fontRegular}</fontPath>
            <fontSize>0.019</fontSize>
            <color>${textDim}</color>
            <zIndex>40</zIndex>
        </text>

        <!-- System row -->
        <image name="selPulse">
            <origin>0.5 0.5</origin>
            <pos>0.5 0.815</pos>
            <size>0.25 0.444</size>
            <path>./assets/images/softglow.svg</path>
            <color>${accent}</color>
            <opacity>0.35</opacity>
            <zIndex>45</zIndex>
        </image>
        <image name="selFrame">
            <origin>0.5 0.5</origin>
            <pos>0.5 0.815</pos>
            <size>0.185 0.13</size>
            <path>${frame}</path>
            <color>${accent}</color>
            <zIndex>46</zIndex>
        </image>
        <carousel name="systemCarousel">
            <type>horizontal</type>
            <pos>0 0.73</pos>
            <size>1 0.17</size>
            <staticImage>${logoWhite}</staticImage>
            <itemSize>0.105 0.06</itemSize>
            <itemScale>1.45</itemScale>
            <maxItemCount>6.5</maxItemCount>
            <unfocusedItemOpacity>0.4</unfocusedItemOpacity>
            <imageInterpolation>linear</imageInterpolation>
            <fastScrolling>true</fastScrolling>
            <color>00000000</color>
            <fontPath>${fontDisplay}</fontPath>
            <fontSize>0.05</fontSize>
            <textColor>${textColor}</textColor>
            <zIndex>50</zIndex>
        </carousel>
    </view>
</theme>
