<!-- Cinematic look: list game view -->
<theme>
    <view name="gamelist">
        <!-- Extra dimming so text stays readable over bright fan art -->
        <image name="listShade">
            <pos>0 0</pos>
            <size>1 1</size>
            <path>${pixel}</path>
            <color>${bgColor}80</color>
            <zIndex>3</zIndex>
        </image>

        <!-- Left top: game list -->
        <textlist name="gamelistTextlist">
            <pos>0.04 0.14</pos>
            <size>0.3 0.47</size>
            <fontPath>${fontRegular}</fontPath>
            <fontSize>${fsList}</fontSize>
            <lineSpacing>1.75</lineSpacing>
            <horizontalMargin>0.012</horizontalMargin>
            <textHorizontalScrolling>true</textHorizontalScrolling>
            <textHorizontalScrollDelay>1</textHorizontalScrollDelay>
            <primaryColor>${textDim}</primaryColor>
            <secondaryColor>${accent}</secondaryColor>
            <selectedColor>${accentText}</selectedColor>
            <selectedSecondaryColor>${accentText}</selectedSecondaryColor>
            <selectedBackgroundColor>${accent}</selectedBackgroundColor>
            <selectedSecondaryBackgroundColor>${accent}</selectedSecondaryBackgroundColor>
            <selectedBackgroundMargins>0.008 0.008</selectedBackgroundMargins>
            <selectedBackgroundCornerRadius>0.006</selectedBackgroundCornerRadius>
            <selectorColor>00000000</selectorColor>
            <zIndex>50</zIndex>
        </textlist>

        <!-- Left bottom: cover + your progress -->
        <image name="infoPanel">
            <pos>0.04 0.64</pos>
            <size>0.3 0.29</size>
            <path>${pixel}</path>
            <color>${panelColor}b0</color>
            <cornerRadius>0.008</cornerRadius>
            <zIndex>4</zIndex>
        </image>
        <image name="cover">
            <origin>0.5 0.5</origin>
            <pos>0.11 0.785</pos>
            <maxSize>0.11 0.255</maxSize>
            <imageType>cover, 3dbox</imageType>
            <cornerRadius>0.004</cornerRadius>
            <interpolation>linear</interpolation>
            <scrollFadeIn>true</scrollFadeIn>
            <zIndex>30</zIndex>
        </image>
        <text name="lblPlaytime, lblPlaycount, lblLastplayed">
            <size>0.15 ${fsLabel}</size>
        </text>
        <text name="lblPlaytime"><pos>0.18 0.66</pos></text>
        <text name="mdPlaytime">
            <pos>0.18 0.68</pos>
            <size>0.15 0.05</size>
            <fontPath>${fontDisplay}</fontPath>
            <fontSize>0.05</fontSize>
        </text>
        <text name="lblPlaycount"><pos>0.18 0.745</pos></text>
        <text name="mdPlaycount">
            <pos>0.18 0.765</pos>
            <size>0.15 ${fsValue}</size>
        </text>
        <text name="lblLastplayed"><pos>0.18 0.81</pos></text>
        <datetime name="mdLastplayed">
            <pos>0.18 0.83</pos>
            <size>0.15 ${fsValue}</size>
        </datetime>
        <rating name="rating">
            <pos>0.18 0.88</pos>
            <size>0 0.026</size>
        </rating>

        <!-- Right: logo, video, badges -->
        <image name="marquee">
            <origin>0.5 0.5</origin>
            <pos>0.6675 0.14</pos>
            <maxSize>0.4 0.13</maxSize>
            <imageType>marquee</imageType>
            <interpolation>linear</interpolation>
            <scrollFadeIn>true</scrollFadeIn>
            <zIndex>35</zIndex>
        </image>
        <video name="video">
            <origin>0.5 0</origin>
            <pos>0.6675 0.225</pos>
            <maxSize>0.575 0.44</maxSize>
            <imageType>screenshot, titlescreen</imageType>
            <delay>1.2</delay>
            <fadeInTime>0.8</fadeInTime>
            <imageCornerRadius>0.008</imageCornerRadius>
            <videoCornerRadius>0.008</videoCornerRadius>
            <scrollFadeIn>true</scrollFadeIn>
            <zIndex>30</zIndex>
        </video>
        <badges name="badges">
            <origin>1 0</origin>
            <pos>0.955 0.69</pos>
            <size>0.16 0.03</size>
            <horizontalAlignment>right</horizontalAlignment>
        </badges>

        <text name="description">
            <pos>0.38 0.69</pos>
            <size>0.41 0.097</size>
            <metadata>description</metadata>
            <container>true</container>
            <fontPath>${fontLight}</fontPath>
            <fontSize>${fsBody}</fontSize>
            <lineSpacing>1.4</lineSpacing>
            <color>${textDim}</color>
            <zIndex>40</zIndex>
        </text>

        <!-- Right bottom: details grid -->
        <text name="lblReleased, lblGenre, lblPlayers, lblDeveloper, lblPublisher, lblEmulator, lblFile">
            <size>0.135 ${fsLabel}</size>
        </text>
        <text name="lblEmulator, lblFile">
            <fontPath>${fontSemi}</fontPath>
            <fontSize>${fsLabel}</fontSize>
            <letterCase>uppercase</letterCase>
            <color>${textMute}</color>
            <metadataElement>true</metadataElement>
            <zIndex>40</zIndex>
        </text>
        <text name="lblEmulator"><text>Emulator</text></text>
        <text name="lblFile"><text>File</text></text>
        <text name="mdGenre, mdPlayers, mdDeveloper, mdPublisher, mdEmulator, mdFile">
            <size>0.135 ${fsValue}</size>
            <container>true</container>
            <containerType>horizontal</containerType>
        </text>
        <text name="mdEmulator, mdFile">
            <fontPath>${fontRegular}</fontPath>
            <fontSize>${fsValue}</fontSize>
            <color>${textColor}</color>
            <zIndex>40</zIndex>
        </text>
        <text name="mdEmulator"><metadata>emulator</metadata></text>
        <text name="mdFile">
            <metadata>physicalNameExtension</metadata>
            <color>${textDim}</color>
        </text>
        <datetime name="mdReleased">
            <size>0.135 ${fsValue}</size>
        </datetime>

        <text name="lblReleased"><pos>0.38 0.815</pos></text>
        <datetime name="mdReleased"><pos>0.38 0.838</pos></datetime>
        <text name="lblGenre"><pos>0.524 0.815</pos></text>
        <text name="mdGenre"><pos>0.524 0.838</pos></text>
        <text name="lblPlayers"><pos>0.668 0.815</pos></text>
        <text name="mdPlayers"><pos>0.668 0.838</pos></text>
        <text name="lblEmulator"><pos>0.812 0.815</pos></text>
        <text name="mdEmulator"><pos>0.812 0.838</pos></text>

        <text name="lblDeveloper"><pos>0.38 0.875</pos></text>
        <text name="mdDeveloper"><pos>0.38 0.898</pos></text>
        <text name="lblPublisher"><pos>0.524 0.875</pos></text>
        <text name="mdPublisher"><pos>0.524 0.898</pos></text>
        <text name="lblFile"><pos>0.668 0.875</pos></text>
        <text name="mdFile">
            <pos>0.668 0.898</pos>
            <size>0.279 ${fsValue}</size>
        </text>
    </view>
</theme>
